    "TARGET_SR": "SR 414.20",
    "TARGET_URL": "https://fedlex.data.admin.ch/eli/cc/2014/691",
    "SNIPPET": "Werden die Voraussetzungen nach Artikel 45 Absatz 1 oder 2 HFKG nicht mehr erfüllt, so beantragt das WBF dem Bundesrat, die Beitragsberechtigung abzuerkennen.",
    "INSIDE_AUTHORIALNOTE": "SR 414.20",
    "preamble_acronym_name": "HFKG",
