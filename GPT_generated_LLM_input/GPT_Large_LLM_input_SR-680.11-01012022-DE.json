  {
    "ITEM": 76,
    "ARTICLE_EID": "art_1",
    "SNIPPET": "f. Landwirtschaftliche Brennerei: Hausbrennerei nach Artikel 14 AlkG;",
    "item_type": "artikel_reference"
  },
  {
    "ITEM": 77,
    "ARTICLE_EID": "art_17",
    "SNIPPET": "Bei Erzeugnissen nach Artikel 2 AlkG und Artikel 23bis AlkG ist für die Besteuerung der darin enthaltene Alkoholgehalt massgebend.",
    "item_type": "artikel_reference"
  },
  {
    "ITEM": 78,
    "ARTICLE_EID": "art_18",
    "SNIPPET": "Ausschliesslich durch Vergärung gewonnene alkoholische Erzeugnisse nach Artikel 1 Buchstabe d sowie Bioethanol zu Treibstoffzwecken unterstehen nicht der Besteuerung.",
    "item_type": "artikel_reference"
  },
  {
    "ITEM": 79,
    "ARTICLE_EID": "art_20",
    "SNIPPET": "d. bei Personen, die gebrannte Wasser einführen im Zeitpunkt der Entstehung der Zollschuld nach Art. 69 des Zollgesetzes vom 18. März 2005.",
    "item_type": "artikel_reference"
  },
  {
    "ITEM": 80,
    "ARTICLE_EID": "art_28",
    "SNIPPET": "a. jährlich mindestens 200 Liter reiner Alkohol im Sinne von Artikel 25 bewirtschaftet werden;",
    "item_type": "artikel_reference"
  },
  {
    "ITEM": 81,
    "ARTICLE_EID": "art_30",
    "SNIPPET": "Die Steuerpflicht entsteht bei der Überführung von gebrannten Wassern aus dem Steuerlager in den steuerrechtlich freien Verkehr oder bei der Feststellung nicht steuerbefreiter Fehlmengen nach Artikel 64.",
    "item_type": "artikel_reference"
  },
  {
    "ITEM": 82,
    "ARTICLE_EID": "art_30",
    "SNIPPET": "Für die Beförderung gelten im Übrigen die Bestimmungen von Artikel 45.",
    "item_type": "artikel_reference"
  },
  {
    "ITEM": 83,
    "ARTICLE_EID": "art_37",
    "SNIPPET": "a. es sich um eine Verwendung gewerblicher Natur nach Artikel 32 Absatz 1 AlkG oder zu Forschungszwecken handelt;",
    "item_type": "artikel_reference"
  },
  {
    "ITEM": 84,
    "ARTICLE_EID": "art_43",
    "SNIPPET": "Artikel 33 und 34 finden entsprechend Anwendung.",
    "item_type": "artikel_reference"
  },
  {
    "ITEM": 85,
    "ARTICLE_EID": "art_49",
    "SNIPPET": "c. der Gesuchsteller oder die Gesuchstellerin nachweist, dass gestützt auf Artikel 31 Absatz 3 AlkG durch das BAZG zugelassene Denaturierungsmethoden zum Einsatz kommen;",
    "item_type": "artikel_reference"
  },
  {
    "ITEM": 86,
    "ARTICLE_EID": "art_52",
    "SNIPPET": "Artikel 33 und 34 finden sinngemäss Anwendung.",
    "item_type": "artikel_reference"
  },
  {
    "ITEM": 87,
    "ARTICLE_EID": "art_54",
    "SNIPPET": "Die Anmeldung muss unmittelbar nach der Entstehung der Steuerforderung erfolgen. Artikel 31, 38, 57 und 58 bleiben vorbehalten.",
    "item_type": "artikel_reference"
  },
  {
    "ITEM": 88,
    "ARTICLE_EID": "art_56",
    "SNIPPET": "Erfüllt die steuerpflichtige Person die rechtlichen Anforderungen an einen Landwirt oder eine Landwirtin nach Artikel 1 Buchstabe e nicht mehr, so erfolgt die Besteuerung bis zum Ablauf des entsprechenden Rechnungsjahrs.",
    "item_type": "artikel_reference"
  },
  {
    "ITEM": 89,
    "ARTICLE_EID": "art_68",
    "SNIPPET": "Unternehmen, die Lebensmittel nach Abs. 1 herstellen, unterstehen den Kontrollvorschriften nach Artikel 42a AlkG.",
    "item_type": "artikel_reference"
  },
  {
    "ITEM": 90,
    "ARTICLE_EID": "art_74",
    "SNIPPET": "b. Beiträge nach Art. 43a AlkG.",
    "item_type": "artikel_reference"
  }
]