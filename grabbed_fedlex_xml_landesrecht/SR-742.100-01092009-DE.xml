<akomaNtoso xmlns="http://docs.oasis-open.org/legaldocml/ns/akn/3.0" xmlns:fedlex="http://fedlex.admin.ch/"><act name="publicLaw"><meta><identification source="#ch.bk"><FRBRWork><FRBRthis value="https://fedlex.data.admin.ch/eli/cc/1988/364_364_364/20090901/main-text"/><FRBRuri value="https://fedlex.data.admin.ch/eli/cc/1988/364_364_364/20090901"/><FRBRdate date="2009-09-01" name="jolux:dateApplicability"/><FRBRdate date="1987-12-06" name="jolux:dateEntryInForce"/><FRBRdate date="1986-12-19" name="jolux:dateDocument"/><FRBRauthor href="#ch.bk" as="#publisher"/><FRBRauthor href="#ch.bk" as="#rightsHolder"/><FRBRcountry value="CH"/><FRBRnumber value="742.100"/><FRBRname xml:lang="it" value="Legge federale del 19 dicembre 1986 concernente il progetto FERROVIA 2000" shortForm=""/><FRBRname xml:lang="fr" value="Loi fédérale du 19 décembre 1986 concernant le projet RAIL 2000" shortForm=""/><FRBRname xml:lang="de" value="Bundesgesetz vom 19. Dezember 1986 betreffend das Konzept BAHN 2000" shortForm=""/><FRBRauthoritative value="true"/></FRBRWork><FRBRExpression><FRBRthis value="https://fedlex.data.admin.ch/eli/cc/1988/364_364_364/20090901/de/main-text"/><FRBRuri value="https://fedlex.data.admin.ch/eli/cc/1988/364_364_364/20090901/de"/><FRBRdate date="2009-09-01" name="jolux:dateApplicability"/><FRBRdate date="1987-12-06" name="jolux:dateEntryInForce"/><FRBRdate date="1986-12-19" name="jolux:dateDocument"/><FRBRauthor href="#ch.bk" as="#publisher"/><FRBRauthor href="#ch.bk" as="#rightsHolder"/><FRBRlanguage language="de"/></FRBRExpression><FRBRManifestation><FRBRthis value="https://fedlex.data.admin.ch/eli/cc/1988/364_364_364/20090901/de/xml/main-text"/><FRBRuri value="https://fedlex.data.admin.ch/eli/cc/1988/364_364_364/20090901/de/xml"/><FRBRdate date="2009-09-01" name="jolux:dateApplicability"/><FRBRdate date="1987-12-06" name="jolux:dateEntryInForce"/><FRBRdate date="1986-12-19" name="jolux:dateDocument"/><FRBRauthor href="#ch.bk" as="#publisher"/><FRBRauthor href="#ch.bk" as="#rightsHolder"/><FRBRformat value="xml" fedlex:generator="2025-q2-rel-1.7.2"/></FRBRManifestation></identification><references source="#ch.bk"><TLCOrganization eId="ch.bk" href="https://fedlex.data.admin.ch/vocabulary/legal-institution/2" showAs="Bundeskanzlei"/><TLCRole eId="publisher" href="http://data.legilux.public.lu/resource/ontology/jolux#publisher" showAs="Editeur"/><TLCRole eId="rightsHolder" href="http://data.legilux.public.lu/resource/ontology/jolux#rightsHolder" showAs="Détenteur des droits"/><TLCReference name="language" href="http://publications.europa.eu/resource/authority/language/DEU" showAs="de"/><TLCReference name="format" href="https://fedlex.data.admin.ch/vocabulary/user-format/xml" showAs="xml"/></references></meta><preface><p><docNumber>742.100 </docNumber></p><p><docTitle>Bundesgesetz <br/>betreffend das Konzept BAHN 2000<inline name="man-font-weight-normal"><sup><authorialNote>
		<p> Fassung gemäss Ziff. I des BG vom 17. Juni 2005, in Kraft seit 1. Jan. 2005 (<ref href="https://fedlex.data.admin.ch/eli/oc/2005/635" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">AS <b>2005</b> 4773</ref>; <ref href="https://fedlex.data.admin.ch/eli/fga/2004/959" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">BBl <b>2004</b> 5313</ref>).</p>
	</authorialNote></sup></inline></docTitle></p><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration">vom 19. Dezember 1986 (Stand am 1. September 2009)</p></preface><preamble><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration">Die Bundesversammlung der Schweizerischen Eidgenossenschaft,</p><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration">gestützt auf die Artikel 23, 26 und 36 der Bundesverfassung<authorialNote>
		<p> Diesen Bestimmungen entsprechen die Artikel 81, 87 und 92 der Bundesverfassung vom 18. April 1999 (<ref href="https://fedlex.data.admin.ch/eli/cc/1999/404" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">SR <b>101</b></ref>).</p>
	</authorialNote>,<sup><authorialNote>
		<p> Fassung gemäss Ziff. I des BG vom 17. Juni 2005, in Kraft seit 1. Jan. 2005 (<ref href="https://fedlex.data.admin.ch/eli/oc/2005/635" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">AS <b>2005</b> 4773</ref>; <ref href="https://fedlex.data.admin.ch/eli/fga/2004/959" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">BBl <b>2004</b> 5313</ref>).</p>
	</authorialNote></sup> <br/>nach Einsicht in den Bericht über das Konzept BAHN 2000 und in eine Botschaft des Bundesrates vom 16. Dezember 1985<authorialNote>
		<p> <ref href="https://fedlex.data.admin.ch/eli/fga/1986/1_193_181_169" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">BBl <b>1986</b> I 193</ref></p>
	</authorialNote>,</p><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration">beschliesst:</p></preamble><body><article eId="art_1"><num><b>Art. 1</b></num><paragraph eId="art_1/para"><content><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration">Der Bund verwirklicht das Konzept BAHN 2000 mit dem Ziel, den öffentlichen Verkehr in der Schweiz zu fördern.</p></content></paragraph></article><article eId="art_2"><num><b>Art. 2</b></num><paragraph eId="art_2/para"><content><blockList><listIntroduction eId="art_2/para/listintro" xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration">Zu diesem Zweck wird das Netz der Schweizerischen Bundesbahnen durch folgende neue Linien erweitert:</listIntroduction><item eId="art_2/para/lbl_a"><num xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration">a.<authorialNote>
		<p> Fassung gemäss Anhang Ziff. 1 des BG vom 20. März 2009 über die zukünftige Entwicklung der Bahninfrastruktur, in Kraft seit 1. Sept. 2009 (<ref href="https://fedlex.data.admin.ch/eli/oc/2009/513" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">AS <b>2009</b> 4219</ref>; <ref href="https://fedlex.data.admin.ch/eli/fga/2007/1222" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">BBl <b>2007</b> 7683</ref>).</p>
	</authorialNote> </num><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration">Vauderens–Siviriez;</p></item><item eId="art_2/para/lbl_b"><num xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration">b. </num><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration">Mattstetten-Rothrist;</p></item><item eId="art_2/para/lbl_c"><num xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration">c.<authorialNote>
		<p> Fassung gemäss Anhang Ziff. 1 des BG vom 20. März 2009 über die zukünftige Entwicklung der Bahninfrastruktur, in Kraft seit 1. Sept. 2009 (<ref href="https://fedlex.data.admin.ch/eli/oc/2009/513" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">AS <b>2009</b> 4219</ref>; <ref href="https://fedlex.data.admin.ch/eli/fga/2007/1222" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">BBl <b>2007</b> 7683</ref>).</p>
	</authorialNote> </num><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration">Muttenz–Liestal (exkl. Bahnhof Liestal).</p></item><item eId="art_2/para/lbl_d"><num xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration">d.<authorialNote>
		<p> Aufgehoben durch Anhang Ziff. 1 des BG vom 20. März 2009 über die zukünftige Entwicklung der Bahninfrastruktur, mit Wirkung seit 1. Sept. 2009 (<ref href="https://fedlex.data.admin.ch/eli/oc/2009/513" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">AS <b>2009</b> 4219</ref>; <ref href="https://fedlex.data.admin.ch/eli/fga/2007/1222" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">BBl <b>2007</b> 7683</ref>).</p>
	</authorialNote> </num><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration">…</p></item></blockList></content></paragraph></article><article eId="art_3"><num><b>Art. 3</b></num><paragraph eId="art_3/para_1"><num>1</num><content><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"> Der Bundesrat genehmigt die Bauetappen und bestimmt den zeitlichen Ablauf.</p></content></paragraph><paragraph eId="art_3/para_2"><num>2</num><content><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"> Der Bundesrat orientiert die eidgenössischen Räte mit dem Geschäftsbericht über den Stand der Verwirklichung des Konzeptes.</p></content></paragraph><paragraph eId="art_3/para_3"><num>3</num><content><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"> Der Bundesrat unterbreitet der Bundesversammlung 2007 eine Vorlage für eine Gesamtschau über die weitere Entwicklung der Eisenbahngrossprojekte und für weitere Phasen sowie deren Finanzierung.<sup><authorialNote>
		<p> Eingefügt durch Ziff. I des BG vom 17. Juni 2005, in Kraft seit 1. Jan. 2005 (<ref href="https://fedlex.data.admin.ch/eli/oc/2005/635" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">AS <b>2005</b> 4773</ref>; <ref href="https://fedlex.data.admin.ch/eli/fga/2004/959" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">BBl <b>2004</b> 5313</ref>).</p>
	</authorialNote></sup></p></content></paragraph></article><article eId="art_3_a"><num><b>Art. 3</b><i>a</i><authorialNote>
		<p>  Eingefügt durch Ziff. II des BB vom 20. März 1998, in Kraft seit 1. Jan. 1999 (<ref href="https://fedlex.data.admin.ch/eli/oc/1999/117" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">AS <b>1999</b> 769 </ref>774; <ref href="https://fedlex.data.admin.ch/eli/fga/1996/4_638_648_551" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">BBl <b>1996</b> IV 638</ref>).</p>
	</authorialNote></num><paragraph eId="art_3_a/para_1"><num>1</num><content><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"> Der Bund stellt den betroffenen Bahnen die benötigten Mittel in Form von marktgemäss verzinslichen oder variabel verzinslichen bedingt rückzahlbaren Darlehen oder von A-Fonds-perdu-Beiträgen zur Verfügung.<sup><authorialNote>
		<p> Fassung gemäss Ziff. I des BG vom 17. Juni 2005, in Kraft seit 1. Jan. 2005 (<ref href="https://fedlex.data.admin.ch/eli/oc/2005/635" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">AS <b>2005</b> 4773</ref>; <ref href="https://fedlex.data.admin.ch/eli/fga/2004/959" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">BBl <b>2004</b> 5313</ref>).</p>
	</authorialNote></sup></p></content></paragraph><paragraph eId="art_3_a/para_1_bis"><num>1bis</num><content><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"> Die Finanzierung richtet sich nach der Verordnung der Bundesversammlung vom 9. Oktober 1998<authorialNote>
		<p> <ref href="https://fedlex.data.admin.ch/eli/cc/2015/107" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">SR <b>742.140</b></ref></p>
	</authorialNote> über das Reglement des Fonds für die Eisenbahngrossprojekte.<sup><authorialNote>
		<p> Eingefügt durch Ziff. I des BG vom 17. Juni 2005, in Kraft seit 1. Jan. 2005 (<ref href="https://fedlex.data.admin.ch/eli/oc/2005/635" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">AS <b>2005</b> 4773</ref>; <ref href="https://fedlex.data.admin.ch/eli/fga/2004/959" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">BBl <b>2004</b> 5313</ref>).</p>
	</authorialNote></sup></p></content></paragraph><paragraph eId="art_3_a/para_2"><num>2</num><content><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"> Marktgemäss verzinsliche Darlehen dürfen höchstens bis zu 25 Prozent der Projektkosten (einschliesslich der Kapitalkosten) gewährt werden. Diese Darlehen werden in der Bestandesrechnung verbucht. Bis zur Inbetriebnahme von Bauabschnitten werden die Darlehenszinsen aktiviert und verzinst.</p></content></paragraph><paragraph eId="art_3_a/para_3"><num>3</num><content><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"> Bundesrat und Bahnen regeln die Einzelheiten der Gewährung von Darlehen in einer Vereinbarung.</p></content></paragraph></article><article eId="art_4"><num><b>Art. 4</b><sup><authorialNote>
		<p> Fassung gemäss Ziff. I des BG vom 17. Juni 2005, in Kraft seit 1. Jan. 2005 (<ref href="https://fedlex.data.admin.ch/eli/oc/2005/635" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">AS <b>2005</b> 4773</ref>; <ref href="https://fedlex.data.admin.ch/eli/fga/2004/959" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">BBl <b>2004</b> 5313</ref>).</p>
	</authorialNote></sup></num><paragraph eId="art_4/para_1"><num>1</num><content><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"> Dieser Beschluss ist allgemein verbindlich<authorialNote>
		<p> Heute: Bundesgesetz (Art. 163 Abs. 1 der Bundesverfassung, <ref href="https://fedlex.data.admin.ch/eli/cc/1999/404" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">SR <b>101</b></ref>).</p>
	</authorialNote>; er untersteht dem fakultativen Referendum.</p></content></paragraph><paragraph eId="art_4/para_2"><num>2</num><content><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"> Er<authorialNote>
		<p> Heute: Bundesgesetz (Art. 163 Abs. 1 der Bundesverfassung, <ref href="https://fedlex.data.admin.ch/eli/cc/1999/404" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">SR <b>101</b></ref>).</p>
	</authorialNote> wird wirksam mit dem Ablauf der Referendumsfrist, wenn kein Referendum zustande kommt, oder mit der Annahme in der Volksabstimmung.</p></content></paragraph><paragraph eId="art_4/para_3"><num>3</num><content><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"> Er<authorialNote>
		<p> Heute: Bundesgesetz (Art. 163 Abs. 1 der Bundesverfassung, <ref href="https://fedlex.data.admin.ch/eli/cc/1999/404" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">SR <b>101</b></ref>).</p>
	</authorialNote> gilt bis zur Verwirklichung des Konzeptes BAHN 2000.</p><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration">Datum des Inkrafttretens: 6. Dezember 1987<authorialNote>
		<p> BRB vom 28. Jan. 1988 (AS <b>1988</b> 365).</p>
	</authorialNote></p></content></paragraph></article></body></act></akomaNtoso>