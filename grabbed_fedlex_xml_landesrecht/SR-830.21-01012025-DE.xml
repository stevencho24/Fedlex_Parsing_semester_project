<akomaNtoso xmlns="http://docs.oasis-open.org/legaldocml/ns/akn/3.0" xmlns:fedlex="http://fedlex.admin.ch/"><act name="publicLaw"><meta><identification source="#ch.bk"><FRBRWork><FRBRthis value="https://fedlex.data.admin.ch/eli/cc/2017/821/20250101/main-text"/><FRBRuri value="https://fedlex.data.admin.ch/eli/cc/2017/821/20250101"/><FRBRdate date="2025-01-01" name="jolux:dateApplicability"/><FRBRdate date="2018-01-01" name="jolux:dateEntryInForce"/><FRBRdate date="2017-11-22" name="jolux:dateDocument"/><FRBRauthor href="#ch.bk" as="#publisher"/><FRBRauthor href="#ch.bk" as="#rightsHolder"/><FRBRcountry value="CH"/><FRBRnumber value="830.21"/><FRBRname xml:lang="fr" value="Ordonnance du 22 novembre 2017 sur la phase initiale d'exploitation de l'établissement «compenswiss (Fonds de compensation AVS/AI/APG)»" shortForm=""/><FRBRname xml:lang="de" value="Verordnung vom 22. November 2017 über die Betriebsaufnahme der Anstalt «compenswiss (Ausgleichsfonds AHV/IV/EO)»" shortForm=""/><FRBRname xml:lang="it" value="Ordinanza del 22 novembre 2017 sull'avvio dell'attività dell'istituto «compenswiss (Fondi di compensazione AVS/AI/IPG)»" shortForm=""/><FRBRauthoritative value="true"/></FRBRWork><FRBRExpression><FRBRthis value="https://fedlex.data.admin.ch/eli/cc/2017/821/20250101/de/main-text"/><FRBRuri value="https://fedlex.data.admin.ch/eli/cc/2017/821/20250101/de"/><FRBRdate date="2025-01-01" name="jolux:dateApplicability"/><FRBRdate date="2018-01-01" name="jolux:dateEntryInForce"/><FRBRdate date="2017-11-22" name="jolux:dateDocument"/><FRBRauthor href="#ch.bk" as="#publisher"/><FRBRauthor href="#ch.bk" as="#rightsHolder"/><FRBRlanguage language="de"/></FRBRExpression><FRBRManifestation><FRBRthis value="https://fedlex.data.admin.ch/eli/cc/2017/821/20250101/de/xml/main-text"/><FRBRuri value="https://fedlex.data.admin.ch/eli/cc/2017/821/20250101/de/xml"/><FRBRdate date="2025-01-01" name="jolux:dateApplicability"/><FRBRdate date="2018-01-01" name="jolux:dateEntryInForce"/><FRBRdate date="2017-11-22" name="jolux:dateDocument"/><FRBRauthor href="#ch.bk" as="#publisher"/><FRBRauthor href="#ch.bk" as="#rightsHolder"/><FRBRformat value="xml" fedlex:generator="2024-q4-rel-1.6.5"/></FRBRManifestation></identification><references source="#ch.bk"><TLCOrganization eId="ch.bk" href="https://fedlex.data.admin.ch/vocabulary/legal-institution/2" showAs="Bundeskanzlei"/><TLCRole eId="publisher" href="http://data.legilux.public.lu/resource/ontology/jolux#publisher" showAs="Editeur"/><TLCRole eId="rightsHolder" href="http://data.legilux.public.lu/resource/ontology/jolux#rightsHolder" showAs="Détenteur des droits"/><TLCReference name="language" href="http://publications.europa.eu/resource/authority/language/DEU" showAs="de"/><TLCReference name="format" href="https://fedlex.data.admin.ch/vocabulary/user-format/xml" showAs="xml"/></references></meta><preface><p><docNumber>830.21 </docNumber></p><p><docTitle>Verordnung <br/>über die Betriebsaufnahme der Anstalt «compenswiss (Ausgleichsfonds AHV/IV/EO)»</docTitle></p><p>vom 22. November 2017 (Stand am 1. Januar 2025)</p></preface><preamble><p>Der Schweizerische Bundesrat,</p><p>gestützt auf die Artikel 13 Absatz 3 und 19 Absatz 2 des Bundesgesetzes <br/>vom 16. Juni 2017<authorialNote><p> <ref href="https://fedlex.data.admin.ch/eli/cc/2017/820" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">SR <b>830.2</b></ref></p></authorialNote> über die Anstalt zur Verwaltung der Ausgleichsfonds von AHV, IV und EO,</p><p>verordnet:</p></preamble><body><article eId="art_1"><num><b>Art. 1</b></num><heading>Sitz der Anstalt</heading><paragraph eId="art_1/para"><content><p>Die Anstalt «compenswiss (Ausgleichsfonds AHV/IV/EO)» hat ihren Sitz in Genf.</p></content></paragraph></article><article eId="art_2"><num><b>Art. 2</b></num><heading>Befugnisse der Organe im Hinblick auf die Betriebsaufnahme</heading><paragraph eId="art_2/para"><content><p>Die Organe der Anstalt sind befugt, die Vorkehrungen zu treffen, die für deren Betriebsaufnahme erforderlich sind. Sie können dazu insbesondere Verträge mit Dritten abschliessen.</p></content></paragraph></article><article eId="art_3"><num><b>Art. 3</b><authorialNote><p> In Kraft bis zum 31. Dez. 2024 (Art. 4 Abs. 2)</p></authorialNote></num></article><article eId="art_4"><num><b>Art. 4</b></num><heading>Inkrafttreten und Geltungsdauer<authorialNote><p> Fassung gemäss Art. 12 der Rechnungslegungsverordnung Compenswiss vom 29. Juni 2022, in Kraft seit 1. Jan. 2025 (<ref href="https://fedlex.data.admin.ch/eli/oc/2022/424" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">AS <b>2022</b> 424</ref>).</p></authorialNote></heading><paragraph eId="art_4/para_1"><num>1</num><content><p> Diese Verordnung tritt am 1. Januar 2018 in Kraft.</p></content></paragraph><paragraph eId="art_4/para_2"><num>2</num><content><p> Artikel 3 gilt bis zum 31. Dezember 2024.<authorialNote><p> Eingefügt durch Art. 12 der Rechnungslegungsverordnung Compenswiss vom 29. Juni 2022, in Kraft seit 1. Jan. 2025 (<ref href="https://fedlex.data.admin.ch/eli/oc/2022/424" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">AS <b>2022</b> 424</ref>).</p></authorialNote></p></content></paragraph></article></body></act></akomaNtoso>