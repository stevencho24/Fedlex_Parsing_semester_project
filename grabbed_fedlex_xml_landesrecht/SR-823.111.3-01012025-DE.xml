2" name="jolux:dateDocument"/><FRBRdate date="2025-01-01" name="jolux:dateEntryInForce"/><FRBRauthor href="#ch.bk" as="#publisher"/><FRBRauthor href="#ch.bk" as="#rightsHolder"/><FRBRformat value="xml" fedlex:generator="2024-q4-rel-1.6.5"/></FRBRManifestation></identification><references source="#ch.bk"><TLCOrganization eId="ch.bk" href="https://fedlex.data.admin.ch/vocabulary/legal-institution/2" showAs="Bundeskanzlei"/><TLCRole eId="publisher" href="http://data.legilux.public.lu/resource/ontology/jolux#publisher" showAs="Editeur"/><TLCRole eId="rightsHolder" href="http://data.legilux.public.lu/resource/ontology/jolux#rightsHolder" showAs="Détenteur des droits"/><TLCReference name="language" href="http://publications.europa.eu/resource/authority/language/DEU" showAs="de"/><TLCReference name="format" href="https://fedlex.data.admin.ch/vocabulary/user-format/xml" showAs="xml"/></references></meta><preface><p><docNumber>823.111.3 </docNumber></p><p><docTitle>Verordnung des WBF <br/>über die Unterstellung von Berufsarten unter die Stellenmeldepflicht im Jahr 2025</docTitle></p><p>vom 22. November 2024 (Stand am 1. Januar 2025)</p></preface><preamble><p>Das Eidgenössische Departement für Wirtschaft, Bildung und Forschung (WBF),</p><p>gestützt auf Artikel 53<i>f</i> der Arbeitsvermittlungsverordnung vom 16. Januar 1991<authorialNote><p>  <ref href="https://fedlex.data.admin.ch/eli/cc/1991/408_408_408" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">SR <b>823.111</b></ref></p></authorialNote> (AVV),</p><p>verordnet:</p></preamble><body><article eId="art_1"><num><b>Art. 1</b></num><heading>Berufsarten, für die eine Stellenmeldepflicht gilt</heading><paragraph eId="art_1/para"><content><p>In den folgenden Berufsarten gilt der Schwellenwert der gesamtschweizerischen Arbeitslosenquote nach Artikel 53<i>a</i> Absatz 1 AVV als erreicht oder überschritten, sodass für diese die Stellenmeldepflicht nach Artikel 21<i>a</i> Absatz 3 des Ausländer- und Integrationsgesetzes vom 16. Dezember 2005<authorialNote><p> <ref href="https://fedlex.data.admin.ch/eli/cc/2007/758" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">SR <b>142.20</b></ref></p></authorialNote> gilt:</p><table border="1"><tr><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>Berufsart</p></th><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>Schweizer Berufs-nomenklatur*<br/>(CH-ISCO-19)</p></th><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>Anzahl <br/>Arbeitslose</p></th><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>Anzahl <br/>Erwerbstätige</p></th><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>Arbeitslosenquote</p></th></tr><tr><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"/><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"/><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"/><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"/><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"/></tr><tr><td><p>Führungskräfte in Vertrieb und Marketing </p></td><td><p>1221</p></td><td><p>2 608</p></td><td><p>45 180</p></td><td><p>5,8 %</p></td></tr><tr><td><p>Biologen/Biologinnen, Botaniker/-innen, Zoologen/Zoologinnen und verwandte Berufe</p></td><td><p>21310</p></td><td><p>451</p></td><td><p>7 078</p></td><td><p>6,4 %</p></td></tr><tr><td><p>Technische Verkaufskräfte (ohne Informations- und Kommunikationstechnologie), Medizin</p></td><td><p>24332</p></td><td><p>123</p></td><td><p>1 798</p></td><td><p>6,8 %</p></td></tr><tr><td><p>Soziologen/Soziologinnen, Anthropologen/Anthropologinnen und verwandte Wissenschaftler/-innen</p></td><td><p>26320</p></td><td><p>83</p></td><td><p>1 480</p></td><td><p>5,6 %</p></td></tr><tr><td><p>Schauspieler/-innen</p></td><td><p>26550</p></td><td><p>170</p></td><td><p>1 409</p></td><td><p>12,1 %</p></td></tr><tr><td><p>Konferenz- und Veranstaltungsplaner/-innen</p></td><td><p>33320</p></td><td><p>303</p></td><td><p>4 741</p></td><td><p>6,4 %</p></td></tr><tr><td><p>Kundeninformationsfachkräfte in Callzentren; Telefonisten/Telefonistinnen</p></td><td><p>4222; 4223</p></td><td><p>467</p></td><td><p>5 116</p></td><td><p>9,1 %</p></td></tr><tr><td><p>Hotelrezeptionisten/-rezeptionistinnen</p></td><td><p>42240</p></td><td><p>230</p></td><td><p>2 705</p></td><td><p>8,5 %</p></td></tr><tr><td><p>Chefs/Cheffes de Service in Restaurants</p></td><td><p>51311</p></td><td><p>405</p></td><td><p>4 240</p></td><td><p>9,6 %</p></td></tr><tr><td><p>Servicehilfskräfte in Restaurants</p></td><td><p>51313</p></td><td><p>1 712</p></td><td><p>33 497</p></td><td><p>5,1 %</p></td></tr><tr><td><p>Betonierer/-innen, Betonoberflächenfertiger/-innen und verwandte Berufe</p></td><td><p>71140</p></td><td><p>452</p></td><td><p>4 274</p></td><td><p>10,6 %</p></td></tr><tr><td><p>Baukonstruktions- und verwandte Berufe, anderweitig nicht genannt </p></td><td><p>71190</p></td><td><p>315</p></td><td><p>4 204</p></td><td><p>7,5 %</p></td></tr><tr><td><p>Gipser/-innen, Trockenbauer/-innen</p></td><td><p>71230</p></td><td><p>724</p></td><td><p>7 378</p></td><td><p>9,8 %</p></td></tr><tr><td><p>Isolierer/-innen, ohne näheren Angaben; Isolierer/-innen Gebäudehülle</p></td><td><p>71240; 71241 </p></td><td><p>323</p></td><td><p>5 830</p></td><td><p>5,5 %</p></td></tr><tr><td><p>Metallpolierer/-innen, Rundschleifer/-innen und Werkzeugschärfer/-innen</p></td><td><p>72240</p></td><td><p>116</p></td><td><p>1 997</p></td><td><p>5,8 %</p></td></tr><tr><td><p>Uhrenarbeiter/-innen</p></td><td><p>73112</p></td><td><p>550</p></td><td><p>8 166</p></td><td><p>6,7 %</p></td></tr><tr><td><p>Bediener/-innen von Wäschereimaschinen</p></td><td><p>81570</p></td><td><p>247</p></td><td><p>4 888</p></td><td><p>5,1 %</p></td></tr><tr><td><p>Gabelstaplerfahrer/-innen und verwandte Berufe</p></td><td><p>83440</p></td><td><p>92</p></td><td><p>1 491</p></td><td><p>6,2 %</p></td></tr><tr><td><p>Hilfsarbeiter/-innen, ohne nähere Angaben; Hilfsarbeiter/-innen im Bergbau, im Bau (ohne Tiefbau), bei der Herstellung von Waren und im Transportwesen</p></td><td><p>90; 93</p><p>ohne 93120</p></td><td><p>10 529</p></td><td><p>89 080</p></td><td><p>11,8 %</p></td></tr><tr><td><p>Hilfsarbeiter/-innen im Gemüse- und Obstbau</p></td><td><p>92110</p></td><td><p>221</p></td><td><p>1 298</p></td><td><p>17,0 %</p></td></tr><tr><td><p>Hilfsarbeiter/-innen im Gartenbau</p></td><td><p>92140</p></td><td><p>346</p></td><td><p>4 882</p></td><td><p>7,1 %</p></td></tr><tr><td><p>Hilfsarbeiter/-innen in der Nahrungsmittelzubereitung </p></td><td><p>94</p></td><td><p>1 959</p></td><td><p>24 200</p></td><td><p>8,1 %</p></td></tr><tr><td><p>Sonstige Hilfsarbeiter/-innen</p></td><td><p>962</p></td><td><p>552</p></td><td><p>7 851</p></td><td><p>7,0 %</p></td></tr><tr><td colspan="5"><blockList><item><num>* </num><p><ref href="https://www.bfs.admin.ch/bfs/de/home/statistiken/arbeit-erwerb/nomenclaturen/ch-isco-19.html">www.bfs.admin.ch</ref> &gt; Grundlagen &gt; Nomenklaturen &gt; Schweizer Berufsnomenklatur CH‑ISCO‑19</p></item></blockList></td></tr></table></content></paragraph></article><article eId="art_2"><num><b>Art. 2</b></num><heading>Inkrafttreten und Geltungsdauer</heading><paragraph eId="art_2/para"><content><p>Diese Verordnung tritt am 1. Januar 2025 in Kraft und gilt bis zum 31. Dezember 2025.</p></content></paragraph></article></body></act></akomaNtoso>