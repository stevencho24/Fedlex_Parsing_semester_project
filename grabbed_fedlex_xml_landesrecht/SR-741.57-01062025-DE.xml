<akomaNtoso xmlns="http://docs.oasis-open.org/legaldocml/ns/akn/3.0" xmlns:fedlex="http://fedlex.admin.ch/"><act name="publicLaw"><meta><identification source="#ch.bk"><FRBRWork><FRBRthis value="https://fedlex.data.admin.ch/eli/cc/2018/782/20250601/main-text"/><FRBRuri value="https://fedlex.data.admin.ch/eli/cc/2018/782/20250601"/><FRBRdate date="2018-11-30" name="jolux:dateDocument"/><FRBRdate date="2019-01-01" name="jolux:dateEntryInForce"/><FRBRdate date="2025-06-01" name="jolux:dateApplicability"/><FRBRauthor href="#ch.bk" as="#publisher"/><FRBRauthor href="#ch.bk" as="#rightsHolder"/><FRBRcountry value="CH"/><FRBRnumber value="741.57"/><FRBRname xml:lang="fr" value="Ordonnance du 30 novembre 2018 sur le système d'information relatif aux accidents de la route (OSAR)" shortForm="OSAR"/><FRBRname xml:lang="it" value="Ordinanza del 30 novembre 2018 concernente il sistema d'informazione sugli incidenti stradali (OSIStr)" shortForm="OSIStr"/><FRBRname xml:lang="de" value="Verordnung vom 30. November 2018 über das Informationssystem Strassenverkehrsunfälle (ISUV)" shortForm="ISUV"/><FRBRauthoritative value="true"/></FRBRWork><FRBRExpression><FRBRthis value="https://fedlex.data.admin.ch/eli/cc/2018/782/20250601/de/main-text"/><FRBRuri value="https://fedlex.data.admin.ch/eli/cc/2018/782/20250601/de"/><FRBRdate date="2018-11-30" name="jolux:dateDocument"/><FRBRdate date="2019-01-01" name="jolux:dateEntryInForce"/><FRBRdate date="2025-06-01" name="jolux:dateApplicability"/><FRBRauthor href="#ch.bk" as="#publisher"/><FRBRauthor href="#ch.bk" as="#rightsHolder"/><FRBRlanguage language="de"/></FRBRExpression><FRBRManifestation><FRBRthis value="https://fedlex.data.admin.ch/eli/cc/2018/782/20250601/de/xml/main-text"/><FRBRuri value="https://fedlex.data.admin.ch/eli/cc/2018/782/20250601/de/xml"/><FRBRdate date="2018-11-30" name="jolux:dateDocument"/><FRBRdate date="2019-01-01" name="jolux:dateEntryInForce"/><FRBRdate date="2025-06-01" name="jolux:dateApplicability"/><FRBRauthor href="#ch.bk" as="#publisher"/><FRBRauthor href="#ch.bk" as="#rightsHolder"/><FRBRformat value="xml" fedlex:generator="2025-q2-rel-1.7.2"/></FRBRManifestation></identification><references source="#ch.bk"><TLCOrganization eId="ch.bk" href="https://fedlex.data.admin.ch/vocabulary/legal-institution/2" showAs="Bundeskanzlei"/><TLCRole eId="publisher" href="http://data.legilux.public.lu/resource/ontology/jolux#publisher" showAs="Editeur"/><TLCRole eId="rightsHolder" href="http://data.legilux.public.lu/resource/ontology/jolux#rightsHolder" showAs="Détenteur des droits"/><TLCReference name="language" href="http://publications.europa.eu/resource/authority/language/DEU" showAs="de"/><TLCReference name="format" href="https://fedlex.data.admin.ch/vocabulary/user-format/xml" showAs="xml"/></references></meta><preface><p><docNumber>741.57 </docNumber></p><p><docTitle>Verordnung<br/>über das Informationssystem Strassenverkehrsunfälle</docTitle></p><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration">(ISUV)</p><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration">vom 30. November 2018 (Stand am 1. Juni 2025)</p></preface><preamble><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration">Der Schweizerische Bundesrat,</p><p xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration">gestützt auf die Artikel 89<i>i</i> Absatz 4, 89<i>l</i> Absatz 3 und 89<i>n</i> des Strassenverkehrsgesetzes vom 19. Dezember 1958<authorialNote>
