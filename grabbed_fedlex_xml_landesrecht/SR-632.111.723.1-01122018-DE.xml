tryInForce"/><FRBRauthor href="#ch.bk" as="#publisher"/><FRBRauthor href="#ch.bk" as="#rightsHolder"/><FRBRformat value="xml" fedlex:generator="2024-q4-rel-1.6.5"/></FRBRManifestation></identification><references source="#ch.bk"><TLCOrganization eId="ch.bk" href="https://fedlex.data.admin.ch/vocabulary/legal-institution/2" showAs="Bundeskanzlei"/><TLCRole eId="publisher" href="http://data.legilux.public.lu/resource/ontology/jolux#publisher" showAs="Editeur"/><TLCRole eId="rightsHolder" href="http://data.legilux.public.lu/resource/ontology/jolux#rightsHolder" showAs="Détenteur des droits"/><TLCReference name="language" href="http://publications.europa.eu/resource/authority/language/DEU" showAs="de"/><TLCReference name="format" href="https://fedlex.data.admin.ch/vocabulary/user-format/xml" showAs="xml"/></references></meta><preface><p><docNumber>632.111.723.1 </docNumber></p><p><docTitle>Verordnung des EFD <br/>über die Ausfuhrbeitragsansätze <br/>für landwirtschaftliche Grundstoffe</docTitle></p><p>vom 9. Januar 2012 (Stand am 1. Dezember 2018)</p></preface><preamble><p>Das Eidgenössische Finanzdepartement (EFD),</p><p>gestützt auf die Artikel 6 Absätze 2–4 und 7 Absatz 1 der <br/>Ausfuhrbeitragsverordnung vom 23. November 2011<authorialNote><p> [<ref href="https://fedlex.data.admin.ch/eli/oc/2011/822" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">AS <b>2011</b> 5939</ref>, <ref href="https://fedlex.data.admin.ch/eli/oc/2016/167" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp"><b>2016</b> 955</ref>, <ref href="https://fedlex.data.admin.ch/eli/oc/2018/630" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp"><b>2018</b> 3935</ref>. <ref href="https://fedlex.data.admin.ch/eli/oc/2018/631" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">AS <b>2018</b> 3937</ref>]</p></authorialNote> <br/>sowie im Einvernehmen mit dem Eidgenössischen Departement für Wirtschaft, Bildung und Forschung<authorialNote><p> Die Bezeichnung der Verwaltungseinheit wurde in Anwendung von Art. 16 Abs. 3 der Publikationsverordnung vom 17. Nov. 2004 (<ref href="https://fedlex.data.admin.ch/eli/oc/2004/746" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">AS <b>2004</b> 4937</ref>) auf den 1. Jan. 2013  angepasst.</p></authorialNote>,</p><p>verordnet:</p></preamble><body><article eId="art_1"><num><b>Art. 1</b></num><heading>Ausfuhrbeitragsansätze</heading><paragraph eId="art_1/para"><content><p>Die Methoden zur Berechnung der Ausfuhrbeitragsansätze und die Ausfuhrbeitragsansätze sind im Anhang festgelegt.</p></content></paragraph></article><article eId="art_2"><num><b>Art. 2</b></num><heading>Ausfuhren nach bestimmten Ländern</heading><paragraph eId="art_2/para_1"><num>1</num><content><p> Ausfuhren nach Andorra, San Marino, die Vatikanstadt, Ceuta und Melilla sowie nach den schweizerischen Zollausschlussgebieten werden den Ausfuhren nach EU-Mitgliedstaaten gleichgestellt.</p></content></paragraph><paragraph eId="art_2/para_2"><num>2</num><content><p> Für ausgeführte Waren, die im Rahmen eines bilateralen Abkommens mit der Schweiz ins Bestimmungsland eingeführt werden, unterliegen die Ausfuhrbeitragsansätze den Bestimmungen des betreffenden Abkommens.</p></content></paragraph></article><article eId="art_3"><num><b>Art. 3</b></num><heading>Aufhebung bisherigen Rechts</heading><paragraph eId="art_3/para"><content><p>Die Verordnung des EFD vom 27. Januar 2005<authorialNote><p> [<ref href="https://fedlex.data.admin.ch/eli/oc/2005/132" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">AS <b>2005</b> 1045</ref>, <ref href="https://fedlex.data.admin.ch/eli/oc/2009/426" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp"><b>2009</b> 3465</ref>, <ref href="https://fedlex.data.admin.ch/eli/oc/2011/613" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp"><b>2011</b> 4457 </ref><ref href="https://fedlex.data.admin.ch/eli/oc/2011/684" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">4791</ref>]</p></authorialNote> über die Ausfuhrbeitragsansätze für landwirtschaftliche Grundstoffe wird aufgehoben.</p></content></paragraph></article><article eId="art_4"><num><b>Art. 4</b></num><heading>Inkrafttreten</heading><paragraph eId="art_4/para"><content><p>Diese Verordnung tritt rückwirkend auf den 1. Januar 2012 in Kraft.</p></content></paragraph></article></body><components><component><doc name="annex"><meta><identification source="#ch.bk"><FRBRWork><FRBRthis value="https://fedlex.data.admin.ch/eli/cc/2012/58/20181201/main-text"/><FRBRuri value="https://fedlex.data.admin.ch/eli/cc/2012/58/20181201"/><FRBRdate date="2018-12-01" name="jolux:dateApplicability"/><FRBRdate date="2012-01-09" name="jolux:dateDocument"/><FRBRdate date="2012-01-01" name="jolux:dateEntryInForce"/><FRBRauthor href="#ch.bk" as="#publisher"/><FRBRauthor href="#ch.bk" as="#rightsHolder"/><FRBRcountry value="CH"/><FRBRnumber value="632.111.723.1"/><FRBRname xml:lang="de" value="Verordnung des EFD vom 9. Januar 2012 über die Ausfuhrbeitragsansätze für landwirtschaftliche Grundstoffe" shortForm=""/><FRBRname xml:lang="it" value="Ordinanza del DFF del 9 gennaio 2012 sulle aliquote dei contributi all'esportazione dei prodotti agricoli di base" shortForm=""/><FRBRname xml:lang="fr" value="Ordonnance du DFF du 9 janvier 2012 sur les taux des contributions à l'exportation de produits agricoles de base" shortForm=""/><FRBRauthoritative value="true"/></FRBRWork><FRBRExpression><FRBRthis value="https://fedlex.data.admin.ch/eli/cc/2012/58/20181201/de/main-text"/><FRBRuri value="https://fedlex.data.admin.ch/eli/cc/2012/58/20181201/de"/><FRBRdate date="2018-12-01" name="jolux:dateApplicability"/><FRBRdate date="2012-01-09" name="jolux:dateDocument"/><FRBRdate date="2012-01-01" name="jolux:dateEntryInForce"/><FRBRauthor href="#ch.bk" as="#publisher"/><FRBRauthor href="#ch.bk" as="#rightsHolder"/><FRBRlanguage language="de"/></FRBRExpression><FRBRManifestation><FRBRthis value="https://fedlex.data.admin.ch/eli/cc/2012/58/20181201/de/xml/main-text"/><FRBRuri value="https://fedlex.data.admin.ch/eli/cc/2012/58/20181201/de/xml"/><FRBRdate date="2018-12-01" name="jolux:dateApplicability"/><FRBRdate date="2012-01-09" name="jolux:dateDocument"/><FRBRdate date="2012-01-01" name="jolux:dateEntryInForce"/><FRBRauthor href="#ch.bk" as="#publisher"/><FRBRauthor href="#ch.bk" as="#rightsHolder"/><FRBRformat value="xml"/></FRBRManifestation></identification></meta><preface><container name="headerOfAnnex"><block name="heading">Anhang<i><authorialNote><p> Fassung gemäss Ziff. I der V des EFD vom 2. Juni 2014 (<ref href="https://fedlex.data.admin.ch/eli/oc/2014/297" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">AS <b>2014</b> 1395</ref>). Bereinigt gemäss Ziff. I der V des EFD vom 21. Dez. 2018, in Kraft seit 1. Dez. 2018  (<ref href="https://fedlex.data.admin.ch/eli/oc/2019/38" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">AS <b>2019</b> 231</ref>).</p></authorialNote></i></block></container></preface><mainBody><p>(Art. 1)</p><level eId="annex_u1/lvl_A"><num>A</num><heading>Die Methoden zur Berechnung der Ausfuhrbeitragsansätze <br/>für Milchgrundstoffe sowie die Ausfuhrbeitragsansätze <br/>für Milchgrundstoffe</heading><content><p>1.  Zur Berechnung der Ausfuhrbeitragsansätze für Milchgrundstoffe gelten folgende Anteile an Milchfett und Milchprotein:</p><table border="1"><tr><th colspan="2" xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>Zolltarifnummer<sup xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp"><authorialNote><p> <ref href="https://fedlex.data.admin.ch/eli/cc/1987/1871_1871_1871" xmlns:data="urn:com:c-moria:legi4ch:xslt:data">SR<b> 632.10</b> </ref>Anhang</p></authorialNote></sup></p></th><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>Referenzprodukt (Kurzbezeichnung)</p></th><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>Anteil <br/>Milchfett</p></th><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p><sub><img fedlex:original-width="" fedlex:original-height="" fedlex:original-text-width="" fedlex:original-page-width="" src="image/image1.png"/></sub></p></th><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>Anteil <br/>Milchprotein</p></th><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p><sub><img fedlex:original-width="" fedlex:original-height="" fedlex:original-text-width="" fedlex:original-page-width="" src="image/image2.png"/></sub></p></th></tr><tr><td><p>ex</p></td><td><p>0402.1000</p></td><td><p>Magermilchpulver (MMP)</p></td><td><p>  0.35 %</p></td><td><p>0.0035</p></td><td><p>34.2 %</p></td><td><p>0.342</p></td></tr><tr><td><p>ex</p></td><td><p>0402.2111/<br/>2119</p></td><td><p>Vollmilchpulver (VMP)</p></td><td><p>26.0 %</p></td><td><p>0.26</p></td><td><p>25.0 %</p></td><td><p>0.25</p></td></tr><tr><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>ex</p></th><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>0405.1011/<br/>1019</p></th><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>Butter (BUT)</p></th><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>82.0 %</p></th><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>0.82</p></th><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>  1.0 %</p></th><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>0.01</p></th></tr></table><p>2.  Zur Berechnung der Ausfuhrbeitragsansätze gelten folgende Preisunterschiede und Kürzungsfaktoren:</p><p>2.1  Ausfuhren in EU-Mitgliedstaaten</p><table border="1"><tr><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>Kurzbezeichnung</p></th><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>Preisunterschied Schweiz – EU Fr./100 kg</p></th><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>Kürzungsfaktor<br/>in %</p></th><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>Preisunterschied nach Kürzung</p></th><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>Maximaler Preisunterschied gemäss Prot. Nr. 2<sup xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp"><authorialNote><p> Prot. Nr. 2 über bestimmte landwirtschaftliche Verarbeitungserzeugnisse  vom 22. Juli 1972 (<ref href="https://fedlex.data.admin.ch/eli/cc/1972/3163_3217_2997" xmlns:data="urn:com:c-moria:legi4ch:xslt:data">SR <b>0.632.401.2</b></ref>).</p></authorialNote></sup></p></th><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>Massgebender Preisunterschied Schweiz – EU</p><p><sup xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">Fr./100 kg </sup><img fedlex:original-width="" fedlex:original-height="" fedlex:original-text-width="" fedlex:original-page-width="" src="image/image3.png"/></p></th></tr><tr><td><p>MMP</p></td><td><p>221.85</p></td><td><p>35</p></td><td><p>144.20</p></td><td><p>198.80</p></td><td><p>144.20</p></td></tr><tr><td><p>VMP</p></td><td><p>285.60</p></td><td><p>35</p></td><td><p>185.64</p></td><td><p>226.55</p></td><td><p>185.65</p></td></tr><tr><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>BUT</p></th><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>467.90</p></th><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>35</p></th><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>304.14</p></th><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>368.20</p></th><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>304.15</p></th></tr></table><p>2.2  Ausfuhren in andere Länder</p><table border="1"><tr><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>Kurzbezeichnung</p></th><th xmlns:mig="urn:com:c-moria:legi4ch:xslt:migration"><p>Preisunterschied Schweiz – a