lder"/><FRBRformat value="xml" fedlex:generator="2024-q4-rel-1.6.5"/></FRBRManifestation></identification><references source="#ch.bk"><TLCOrganization eId="ch.bk" href="https://fedlex.data.admin.ch/vocabulary/legal-institution/2" showAs="Bundeskanzlei"/><TLCRole eId="publisher" href="http://data.legilux.public.lu/resource/ontology/jolux#publisher" showAs="Editeur"/><TLCRole eId="rightsHolder" href="http://data.legilux.public.lu/resource/ontology/jolux#rightsHolder" showAs="Détenteur des droits"/><TLCReference name="language" href="http://publications.europa.eu/resource/authority/language/DEU" showAs="de"/><TLCReference name="format" href="https://fedlex.data.admin.ch/vocabulary/user-format/xml" showAs="xml"/></references></meta><preface><p><docNumber>351.13 </docNumber></p><p><docTitle>Verordnung <br/>über die Zusammenarbeit mit der Europäischen Staatsanwaltschaft</docTitle></p><p>vom 21. Dezember 2022 (Stand am 15. Februar 2023)</p></preface><preamble><p>Der Schweizerische Bundesrat,</p><p>gestützt auf den Artikel 1 Absatz 3<sup>ter </sup>des Rechtshilfegesetzes vom 20. März 1981<authorialNote><p>  <ref href="https://fedlex.data.admin.ch/eli/cc/1982/846_846_846" xmlns:data="urn:com:c-moria:legi4ch:xslt:data" xmlns:tmp="urn:com:c-moria:legi4ch:xslt:temp">SR <b>351.1</b></ref></p></authorialNote> (IRSG),</p><p>verordnet:</p></preamble><body><article eId="art_1"><num><b>Art. 1</b></num><paragraph eId="art_1/para"><content><p>Das IRSG ist sinngemäss auf Verfahren der Zusammenarbeit mit der Europäischen Staatsanwaltschaft anwendbar.</p></content></paragraph></article><article eId="art_2"><num><b>Art. 2</b></num><paragraph eId="art_2/para"><content><p>Diese Verordnung tritt am 15. Februar 2023 in Kraft.</p></content></paragraph></article></body></act></akomaNtoso>